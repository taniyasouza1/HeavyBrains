# Crustdata (server-side only; never prefix with NEXT_PUBLIC_)
CRUSTDATA_API_KEY=
# Optional: request the `skills` field (needs plan access, else 403)
CRUSTDATA_INCLUDE_SKILLS=false
# Default mode when the UI has no choice yet: demo | live
DATA_MODE=demo

# --- AI agents (optional) ---
# Anthropic API key. When set, the agent pipeline can run: Brief Analyst, Search Strategist,
# Evidence Reviewers and Briefing Writer. Leave empty to use keyword rules only.
ANTHROPIC_API_KEY=
# Model for every agent. Defaults to claude-opus-5-5.
# ANTHROPIC_MODEL=claude-opus-5-5
# Optional cheaper model just for the parallel Evidence Reviewers (the biggest share of calls).
# ANTHROPIC_REVIEW_MODEL=claude-sonnet-5-5
